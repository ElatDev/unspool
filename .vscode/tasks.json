      "type": "shell",
      "command": "python tools/make_demo.py && python tools/render_screenshot.py",
      "problemMatcher": []
    },
    {
      "label": "Compare against tshark",
      "type": "shell",
      "command": "python tools/compare_tshark.py",
      "problemMatcher": []
    }
  ]
