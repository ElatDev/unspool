{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Tests",
      "type": "shell",
      "command": "python -m pytest -q",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Lint (ruff + mypy)",
      "type": "shell",
      "command": "ruff check . && mypy",
